@model AgenciaDeViagens.ViewModel.LoginViewModel
@{
    ViewData["Title"] = "Login";
}

<div class="container">
    <h1>@ViewData["Title"]</h1>
    <h4>Use uma conta local para fazer login.</h4>
    <hr />

    <div class="container mt-4 mb-3">
        <section class="row w-100 justify-content-center">
            <div class="border border-1 rounded col-6 shadow p-3">
                @if (!ViewData.ModelState.IsValid)
                {
                    foreach (var error in ViewData.ModelState[string.Empty]?.Errors ?? Enumerable.Empty<Microsoft.AspNetCore.Mvc.ModelBinding.ModelError>())
                    {
                        <span class="text-danger">@error.ErrorMessage</span>
                    }
                }
                <form asp-action="Login" method="post">
                    <div class="mb-2">
                        <label asp-for="Email"></label><br />
                        <input asp-for="Email" class="form-control mb-2" />
                        <span asp-validation-for="Email" style="color: red;"></span>
                    </div>
                    <br />
                    <div>
                        <label asp-for="Password"></label><br />
                        <input asp-for="Password" class="form-control mb-2"/>
                        <span asp-validation-for="Password" style="color: red;"></span>
                    </div>
                    <br />
                    <label class="mb-3 d-flex gap-2">
                        <label for="RememberMe">Lembre-me</label>
                        <input asp-for="RememberMe" name="RememberMe" />
                    </label>
                    <div class="d-flex">
                        <button type="submit" class="btn btn-success me-3">Login</button>
                        <a asp-controller="Account" asp-action="ForgotPassword" class="btn btn-primary">Esqueceu sua senha?</a>
                    </div>
                </form>
            </div>
        </section>
    </div>
</div>