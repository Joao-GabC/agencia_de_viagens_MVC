@model AgenciaDeViagens.ViewModel.RegisterAtendenteViewModel
@{
    ViewData["Title"] = "Registrar";
}

<div class="container">
    <h1>@ViewData["Title"]</h1>
    <h4>Crie uma nova conta de funcionário.</h4>
    <hr />

    <div class="container mt-4 mb-3">
        <section class="row w-100 justify-content-center">
            <div class="border border-1 rounded col-6 shadow p-3 w-75">
                <form method="post">
                    <div asp-validation-summary="All" style="color: red;"></div>

                    <h5>Dados da Conta</h5>
                    <div class="row mb-3">
                        <div class="col">
                            <div class="row">
								<div class="col">
									<label asp-for="Email"></label>
									<input asp-for="Email" class="form-control" />
								</div>
								<div class="col-3">
									<label>Senha</label>
									<input asp-for="Password" class="form-control" />
								</div>
								<div class="col-3">
									<label asp-for="ConfirmPassword"></label>
									<input asp-for="ConfirmPassword" class="form-control" />
                                </div>
                            </div>
                        </div>
                    </div>

                    <h5>Seus dados</h5>
                    <div class="row mb-4">
                        <div class="col">
                            <div class="row">
                                <div class="col">
									<label asp-for="Nome"></label><br />
									<input asp-for="Nome" class="form-control" />
                                </div>
                                <div class="col">
                                    <label asp-for="Departamento"></label><br />
                                    <input asp-for="Departamento" class="form-control" />
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex">
                        <button type="submit" class="btn btn-success me-3">Registrar</button>
                        <a asp-controller="Account" asp-action="Register" class="btn btn-primary">Fazer conta de cliente</a>
                    </div>
                </form>
            </div>
        </section>
    </div>
</div>
